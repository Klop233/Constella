# Copy to deploy/.env (chmod 600). Never commit the real file.

# Master key used to encrypt provider keys and secrets stored in the hub database (32 bytes, base64).
CONSTELLA_MASTER_KEY=

# One-time code required to create the owner account on first visit.
CONSTELLA_SETUP_CODE=

# Origins the app is opened from (WebAuthn + CSRF). Comma separated, no trailing slash.
CONSTELLA_ORIGINS=https://your-machine.your-tailnet.ts.net,http://localhost:8780

# Optional dev entry: requests on this port count as the owner without logging in.
# Publish it only on loopback / tailnet addresses (docker-compose.override.yml), never publicly.
# CONSTELLA_TRUSTED_PORT=8790

TZ=Asia/Shanghai

# new-api (OpenAI-compatible gateway on the host, reached from containers via host-gateway).
NEWAPI_BASE_URL=http://host.docker.internal:3333
NEWAPI_API_KEY=
# Optional: new-api system access token (+ its user id), lets the hub create one token per agent and read usage.
NEWAPI_ADMIN_TOKEN=
NEWAPI_ADMIN_USER_ID=1

# Default model for new agents, and the cheap model used for post-run reflection.
CONSTELLA_DEFAULT_MODEL=gpt-6-astra
CONSTELLA_REFLECT_MODEL=mimo-v2.5-pro

# Web Push (VAPID) keys, generated on first start if empty.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional fallback notification channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloudflare Tunnel token for the public entry (docker compose --profile public up -d).
CLOUDFLARE_TUNNEL_TOKEN=
