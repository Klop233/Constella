# Copy to deploy/.env (chmod 600). Never commit the real file.

# Master key used to encrypt provider keys and secrets stored in the hub database (32 bytes, base64).
CONSTELLA_MASTER_KEY=

# Optional one-time code required to create the owner account on first visit.
# Off by default: leave empty and the first visitor creates the account directly.
# Set it (then restart hub) when the instance is reachable before you get to it.
CONSTELLA_SETUP_CODE=

# Origins the app is opened from (WebAuthn + CSRF). Comma separated, no trailing slash.
CONSTELLA_ORIGINS=https://your-machine.your-tailnet.ts.net,http://localhost:8780

# Optional dev entry: requests on this port count as the owner without logging in.
# Publish it only on loopback / tailnet addresses (docker-compose.override.yml), never publicly.
# CONSTELLA_TRUSTED_PORT=8790

TZ=Asia/Shanghai

# Persistent data directory. The hub passes this same path into agent/desktop containers.
CONSTELLA_DATA_DIR=/root/constella_data

# Model upstream is configured in the app (first-run wizard or 设置 → 模型): any address that
# speaks the OpenAI Responses API. Nothing is tied to a particular gateway.

# Optional starting refs; a provider must exist for them to resolve. Use "model" for the default
# provider or "model@provider" to name one.
CONSTELLA_DEFAULT_MODEL=
CONSTELLA_REFLECT_MODEL=

# Web Push (VAPID) keys, generated on first start if empty.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional fallback notification channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Instances (optional; defaults shown). Images the hub starts for each kind; scripts/build-android-images.sh reads
# these too, so it builds under the names the hub expects.
# CONSTELLA_DESKTOP_IMAGE=constella-desktop:latest
# CONSTELLA_ANDROID_BRIDGE_IMAGE=constella-android-bridge:latest
# CONSTELLA_REDROID_IMAGE=constella-redroid:latest
# CONSTELLA_REDROID_GAPPS_IMAGE=constella-redroid:gapps
# CONSTELLA_EMULATOR_IMAGE=constella-emulator:latest
# CONSTELLA_EMULATOR_PLAYSTORE_IMAGE=constella-emulator:playstore
# Memory limit per instance container (MB).
# CONSTELLA_MEM_BROWSER_MB=2048
# CONSTELLA_MEM_DESKTOP_MB=3072
# CONSTELLA_MEM_ANDROID_MB=4096

# Optional override for the online Office image. The installer only pulls it when selected in the wizard.
# CONSTELLA_OFFICE_IMAGE=onlyoffice/documentserver:latest
