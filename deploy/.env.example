# Copy to deploy/.env (chmod 600). Never commit the real file.

# Master key used to encrypt provider keys and secrets stored in the hub database (32 bytes, base64).
CONSTELLA_MASTER_KEY=

# Hub listens on loopback only; Tailscale Serve and cloudflared forward to it.
CONSTELLA_LISTEN=127.0.0.1:8780
CONSTELLA_DATA_DIR=/srv/constella

# new-api (OpenAI-compatible gateway on the host, reached from containers via host-gateway).
NEWAPI_BASE_URL=http://host.docker.internal:3333
NEWAPI_API_KEY=
# Optional: new-api system access token, lets the hub create one token per agent and read usage.
NEWAPI_ADMIN_TOKEN=

# Cheap model used for post-run reflection (self-learning).
CONSTELLA_REFLECT_MODEL=deepseek-v4-flash

# Web Push (VAPID) keys, generated on first start if empty.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional fallback notification channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloudflare Tunnel token for the public entry (phase 4).
CLOUDFLARE_TUNNEL_TOKEN=
